# ============================================================
# BJP Nalam Thittam — Backend environment (Render deployment)
# Copy to .env for local dev. On Render, set these in the
# dashboard: Service → Environment → Environment Variables.
# NEVER commit real secrets — this file holds placeholders only.
# ============================================================

# Render provides PORT automatically at runtime; 5000 is the local default.
PORT=5000

# Required. Long random string. The server refuses to start without it.
JWT_SECRET=change_me_to_a_long_random_secret

# ── DB 1: Voter database (READ ONLY) ──
MONGO_VOTER_URL=your_voter_mongodb_url
MONGO_VOTER_DB_NAME=voter_db

# ── DB 2: App database (READ + WRITE) — Atlas cluster ──
# Holds Users, SchemeApplications, Admins, etc.
MONGO_APP_URL=your_atlas_app_mongodb_url
MONGO_DB=bjp_nalam_thittam_db

# ── Deployment URLs (used in the "/" status route and for reference) ──
# Frontend on Vercel, backend on Render. Use your real URLs.
FRONTEND_URL=https://bjp-scheme.vercel.app
BACKEND_URL=https://bjp-scheme.onrender.com

# ── SMS providers ──
FAST2SMS_API_KEY=your_fast2sms_api_key
SMS_API_KEY=your_2factor_api_key
SMS_TEMPLATE_NAME=OTP1

# ── Logging (winston) ──
# LOG_LEVEL: error | warn | info | http | debug  (default: info in prod)
LOG_LEVEL=info
# On Render (ephemeral filesystem) keep this false and rely on stdout capture.
LOG_TO_FILE=false

# ── Gemini AI Command Console (admin analytics) ──
# Keep the key ONLY on the backend — never in frontend code.
GEMINI_API_KEY=your_gemini_api_key
# Valid models: gemini-flash-latest | gemini-2.5-flash | gemini-2.0-flash
GEMINI_MODEL=gemini-flash-latest

# ── Live tracking ──
# Cache window (ms) for polling live-stats endpoints — collapses repeated polls.
LIVE_CACHE_TTL_MS=3000
# Secret token for the no-login read-only public live view (/live?token=...).
LIVE_SHARE_TOKEN=generate_a_long_random_token
